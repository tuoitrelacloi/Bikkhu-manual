    },
    {
      "id": "0a73114279c3d36e",
      "type": "text",
      "text": "\n\n# [4] Kasmā gopesi suvānaṃ bhussamāno sayaṃ? (Ngạn ngữ Anh)  ",
      "styleAttributes": {},
      "x": 4900,
      "y": 0,
      "width": 1360,
      "height": 113
    },
    {
      "id": "93331638b549b07c",
      "type": "text",
      "text": "# Tvaṃ",
      "styleAttributes": {},
      "x": 4900,
      "y": 331,
      "width": 260,
      "height": 60
    },
    {
      "id": "2bc79ecbce46d522",
      "type": "text",
      "text": "# sayaṃ\nTrạng từ\nTự mình",
      "styleAttributes": {},
      "x": 5030,
      "y": 760,
      "width": 260,
      "height": 220
    },
    {
      "id": "ac5a7e23a0d7877b",
      "type": "text",
      "text": "# Trong khi tự mình sủa TẠI SAO bạn bảo vệ con chó?",
      "styleAttributes": {},
      "x": 5030,
      "y": 1040,
      "width": 970,
      "height": 120
    },
    {
      "id": "502ee4030e6ee9c1",
      "type": "text",
      "text": "# Tại sao bạn phải làm việc của con chó??\n# Câu hỏi tu từ - Nhấn mạnh ý của người nói",
      "styleAttributes": {},
      "x": 5030,
      "y": 1280,
      "width": 1230,
      "height": 160
    },
    {
      "id": "35a25b9e7e8443cb",
      "type": "text",
      "text": "# bhussamāno\nHTPT\nSủa",
      "styleAttributes": {},
      "x": 5030,
      "y": 514,
      "width": 260,
      "height": 173
    },
    {
      "id": "42618e8e2f3625c5",
      "type": "text",
      "text": "# gopesi\nĐộng từ, CĐ, Ngôi 2 số ít\nBạn - Bảo vệ",
      "styleAttributes": {},
      "x": 5457,
      "y": 334,
      "width": 260,
      "height": 226,
      "color": "5"
    },
    {
      "id": "68b16248931cfb73",
      "type": "text",
      "text": "# Kasmā\nTrạng từ\nTại sao?",
      "styleAttributes": {},
      "x": 5560,
      "y": 660,
      "width": 260,
      "height": 140
    },
    {
      "id": "5835364cd7352e39",
      "type": "text",
      "text": "# suvānaṃ\nTBC, Con chó",
      "styleAttributes": {},
      "x": 6000,
      "y": 334,
      "width": 260,
      "height": 221,
      "color": "6"
    },
    {
      "id": "ed1fec4ea807e994",
      "type": "text",
      "text": "# Bạn nên cư xử với các vị trời giống như mọi người có thể nghe bạn.",
      "styleAttributes": {},
      "x": 930,
      "y": 1080,
      "width": 1050,
      "height": 80
    },
    {
      "id": "a7c18521345a250c",
      "type": "text",
      "text": "# suṇeyyuṃ\n**Suṇeyya** Nghe\nHọ nghe\nCó thể nge ",
      "styleAttributes": {},
      "x": 1300,
      "y": 755,
      "width": 260,
      "height": 170
    },
    {
      "id": "862688a8059b9f7d",
      "type": "text",
      "text": "# tuvaṃ\nTBC, số ít\nBạn",
      "styleAttributes": {},
      "x": 1720,
      "y": 760,
      "width": 260,
      "height": 160
    },
    {
      "id": "48d29135d06bdacf",
      "type": "text",
      "text": "# devatāhi\nDCC số nhiều\nVới những vị trời",
      "styleAttributes": {},
      "x": 1720,
      "y": 300,
      "width": 260,
      "height": 200
    },
    {
      "id": "627c2e62c8af1233",
      "type": "text",
      "text": "# Ācareyyāsi\nV, CKC, Ngôi 2 số ít - Bạn cư xử",
      "styleAttributes": {},
      "x": 1300,
      "y": 330,
      "width": 260,
      "height": 140
    },
    {
      "id": "983cff57ddc62e38",
      "type": "text",
      "text": "# Bạn nên cư xử với mọi người giống như các vị trời có thể thấy bạn.",
      "styleAttributes": {},
      "x": 2207,
      "y": 1080,
      "width": 1050,
      "height": 80
    },
    {
      "id": "b1d18df1442c83a3",
      "type": "text",
      "text": "# devatā\nCác vị trời",
      "styleAttributes": {},
      "x": 2207,
      "y": 740,
      "width": 260,
      "height": 200
    },
    {
      "id": "5f2de64203181b9a",
      "type": "text",
      "text": "# [3] Ācareyyāsi ca devatāhi yathā sabbe purisā suṇeyyuṃ tuvaṃ; \n# ācareyyāsi ca narehi yathā devatā passeyyuṃ tuvaṃ (Song cú Latin)",
      "styleAttributes": {},
      "x": 980,
      "y": -180,
      "width": 800,
      "height": 220
    },
    {
      "id": "22d87e32d66113ee",
      "type": "text",
      "text": "# Ācareyya",
      "styleAttributes": {},
      "x": 1300,
      "y": 230,
      "width": 260,
      "height": 60
    },
    {
      "id": "f6596737e9487f8f",
      "type": "text",
      "text": "# Liêm chính, nhất quán trong hành vi. Khi tương tác với ai, luôn hành động một cách cẩn trọng",
      "styleAttributes": {},
      "x": 930,
      "y": 1320,
      "width": 1407,
      "height": 120,
      "color": "1"
    },
    {
      "id": "9adc005ed31535f1",
      "type": "text",
      "text": "# Làm sao thì nói vậy, nói sao thì làm vậy\n# Dù nơi nhiều người hay không có người",
      "styleAttributes": {},
      "x": 930,
      "y": 1560,
      "width": 1407,
      "height": 176
    },
    {
      "id": "8379d13049bc0115",
      "type": "text",
      "text": "# Luận giải: Chư thiên - những người có địa vị\n## Cư xử với họ theo cách ",
      "styleAttributes": {},
      "x": 830,
      "y": 1840,
      "width": 1070,
      "height": 182
    },
    {
      "id": "d50138d6ddebf81d",
      "type": "text",
      "text": "# (Bạn)",
      "styleAttributes": {},
      "x": 2207,
      "y": 410,
      "width": 260,
      "height": 60
    },
    {
      "id": "aab40997b9a64126",
      "type": "text",
      "text": "# ca",
      "styleAttributes": {},
      "x": 2207,
      "y": 240,
      "width": 130,
      "height": 60
    },
    {
      "id": "421fd7a92c643aa1",
      "type": "text",
      "text": "# ācareyyāsi ca narehi yathā devatā passeyyuṃ tuvaṃ (Song cú Latin)",
      "styleAttributes": {},
      "x": 2207,
      "y": -70,
      "width": 1087,
      "height": 110
    },
    {
      "id": "d27dd61c174119f0",
      "type": "text",
      "text": "# Luận giải: Chư thiên - những người có địa vị\n## Cư xử với họ theo cách  ",
      "styleAttributes": {},
      "x": 830,
      "y": 2101,
      "width": 1070,
      "height": 182
    },
    {
      "id": "249bc8c85abd9f7c",
      "type": "text",
      "text": "# sabbe purisā \nTất cả mọi người",
      "styleAttributes": {},
      "x": 930,
      "y": 740,
      "width": 260,
      "height": 200
    },
    {
      "id": "ad22d9f4bde09f13",
      "type": "text",
      "text": "# (Bạn)",
      "styleAttributes": {},
      "x": 930,
      "y": 410,
      "width": 260,
      "height": 60
    },
    {
      "id": "c89022c94427cc4e",
      "type": "text",
      "text": "# yathā\nGiống như",
      "styleAttributes": {},
      "x": 690,
      "y": 520,
      "width": 140,
      "height": 140,
      "color": "1"
    },
    {
      "id": "5d9c3141fb6f1d8d",
      "type": "text",
      "text": "# Nên",
      "styleAttributes": {},
      "x": 620,
      "y": 230,
      "width": 140,
      "height": 100
    },
    {
      "id": "3eb45f071b09500b",
