      "label": " ít-kinh-điển"
    },
    {
      "id": "adbbf224ef60828f",
      "type": "text",
      "text": "# hoti",
      "styleAttributes": {},
      "x": -1875,
      "y": 5522,
      "width": 250,
      "height": 60
    },
    {
      "id": "97b506186f115f2c",
      "type": "text",
      "text": "# rāgaṃ\n(rāgañca = rāgaṃ + ca )\nn, m, tbc, ít/TTTT cho pahāya/tham",
      "styleAttributes": {},
      "x": -1872,
      "y": 4342,
      "width": 280,
      "height": 160
    },
    {
      "id": "9c393741ad068971",
      "type": "text",
      "text": "# pahāya\nĐTBB/diễn tả hành động xảy ra trước hành động của chủ từ/sau khi từ bỏ\n",
      "styleAttributes": {},
      "x": -2207,
      "y": 4347,
      "width": 280,
      "height": 150
    },
    {
      "id": "e106f97d0759d1c6",
      "type": "text",
      "text": "# sa: \nĐTNC/CĐ, dùng như tính từ, m, cc, ít/ BNTT cho anupādiyāno/người ấy, người đó",
      "styleAttributes": {},
      "x": -2201,
      "y": 5757,
      "width": 260,
      "height": 190
    },
    {
      "id": "0b5b50fc5f38515a",
      "type": "text",
      "text": "# sāmaññassa\nn, m, shc, ít/SHC tổng thể/trạng thái Sa Môn",
      "styleAttributes": {},
      "x": -1221,
      "y": 5782,
      "width": 300,
      "height": 140
    },
    {
      "id": "fc52ce75dcef2f29",
      "type": "text",
      "text": "# huraṃ\nadv, BN cho động từ hoti/kiếp sau",
      "styleAttributes": {},
      "x": -1721,
      "y": 5792,
      "width": 260,
      "height": 130
    },
    {
      "id": "9134577cb36d31f1",
      "type": "text",
      "text": " # dosaṃ\n(dosañca = dosaṃ + ca )\nn, m, tbc, ít/TTTT cho pahāya/sân",
      "styleAttributes": {},
      "x": -1872,
      "y": 4527,
      "width": 280,
      "height": 160
    },
    {
      "id": "aae411711da11fe5",
      "type": "text",
      "text": " # mohaṃ\nn, m, tbc, ít/TTTT cho pahāya/si",
      "styleAttributes": {},
      "x": -1872,
      "y": 4727,
      "width": 280,
      "height": 160
    },
    {
      "id": "8d083e737ca6922b",
      "type": "text",
      "text": "# idha\nadv/BN cho động từ hoti/kiếp này\n",
      "styleAttributes": {},
      "x": -2501,
      "y": 5307,
      "width": 260,
      "height": 140
    },
    {
      "id": "51b511b0ef99b8d6",
      "type": "text",
      "text": "# bhāgavā\nn, m, cc, ít/VN CĐL/người dự phần",
      "styleAttributes": {},
      "x": -1490,
      "y": 5497,
      "width": 340,
      "height": 110
    },
    {
      "id": "bf64666d60a4fbfe",
      "type": "text",
      "text": "# anupādiyāno\nHTPT, dùng như noun, m, cc, ít/chủ từ/ Người không dính mắc",
      "styleAttributes": {},
      "x": -2281,
      "y": 5472,
      "width": 280,
      "height": 160
    },
    {
      "id": "a57e77b81390e42b",
      "type": "text",
      "text": "# hoti\ntrở thành",
      "styleAttributes": {},
      "x": -1925,
      "y": 4052,
      "width": 250,
      "height": 125
    },
    {
      "id": "940f9019f67a27d2",
      "type": "text",
      "text": "# Câu 4: rāgañca dosañca pahāya mohaṃ, sammappajāno suvimuttacitto.",
      "styleAttributes": {},
      "x": -2510,
      "y": 3887,
      "width": 1000,
      "height": 120
    },
    {
      "id": "e5d6dc2f42e51ee6",
      "type": "text",
      "text": "# so\n(thay thế cho bhāsamāno)\nĐTNX, m, ngôi 3, ít/chủ từ/Vị ấy",
      "styleAttributes": {},
      "x": -2381,
      "y": 4022,
      "width": 300,
      "height": 190,
      "color": "1"
    },
    {
      "id": "c742307b8cec7cc9",
      "type": "text",
      "text": "# sammappajāno \nn, m, cc, ít/VN CĐL/người tỉnh giác",
      "styleAttributes": {},
      "x": -1214,
      "y": 4047,
      "width": 310,
      "height": 130
    },
    {
      "id": "6c47109fd0358292",
      "type": "text",
      "text": "# suvimuttacitto\nn, m, cc, ít/ĐVN với sammappajāno/người có tâm giải thoát",
      "styleAttributes": {},
      "x": -1109,
      "y": 4237,
      "width": 330,
      "height": 160
    },
    {
      "id": "e74656035f91ad07",
      "type": "text",
      "text": "# Dịch: sau khi từ bỏ tham, sân, si, vị ấy là người tỉnh giác - người có tâm giải thoát",
      "styleAttributes": {},
      "x": -261,
      "y": 3787,
      "width": 1000,
      "height": 100
    },
    {
      "id": "f6456209d383c364",
      "type": "text",
      "text": "# Câu 5: anupādiyāno idha vā huraṃ vā, sa bhāgavā sāmaññassa hoti.",
      "styleAttributes": {},
      "x": -236,
      "y": 4707,
      "width": 1035,
      "height": 80
    },
    {
      "id": "b2792fd8723086e0",
      "type": "text",
      "text": "# appaṃ\n(appampi = appaṃ +pi)\nadi, nt, TBC, ít/BNTT cho sahitaṃ/ít",
      "styleAttributes": {},
      "x": -2041,
      "y": 3239,
      "width": 311,
      "height": 160
    },
    {
      "id": "5a16bb33d8414d5e",
      "type": "text",
      "text": "# hoti",
      "styleAttributes": {},
      "x": -1860,
      "y": 2909,
      "width": 130,
      "height": 50
    },
    {
      "id": "9f25870b591f99f0",
      "type": "text",
      "text": "# Dịch: kiếp này và kiếp sau, người không dính mắc ấy là người dự phân trạng thái Sa Môn.",
      "styleAttributes": {},
      "x": -236,
      "y": 4827,
      "width": 1035,
      "height": 140
    },
    {
      "id": "2f1b2ffc2f375796",
      "type": "text",
      "text": "# SHC - như túc từ\nPhương thức cho hành pháp (Hành đúng hay sai)",
      "styleAttributes": {},
      "x": -1581,
      "y": 3519,
      "width": 453,
      "height": 108
    },
    {
      "id": "f061609ca91858ee",
      "type": "text",
      "text": "# bhāsamāno\nHTPT, dùng như noun, m, cc, ít/chủ từ/người nói",
      "styleAttributes": {},
      "x": -2280,
      "y": 2867,
      "width": 300,
      "height": 133
    },
    {
      "id": "99427351fa584378",
      "type": "text",
      "text": "# ce\nphụ từ/thường đi với từ đầu tiên trong câu/nếu",
      "styleAttributes": {},
      "x": -2521,
      "y": 2867,
      "width": 200,
      "height": 212
    },
    {
      "id": "3cfe33844961ee89",
      "type": "text",
      "text": "# anudhammacārī.\nn, m, cc, ít/VN CĐL/ người hành theo pháp\n[anudhammacārī](https://dpdict.net/?q=anudhammac%C4%81r%C4%AB#anudhammac%C4%81r%C4%AB) adj. **living according to the Dhamma;**",
      "styleAttributes": {},
      "x": -1494,
      "y": 2834,
      "width": 366,
      "height": 200
    },
    {
      "id": "c6527505fc79d9cd",
      "type": "text",
      "text": "# takkaro\n(= Tad + karo)\nn, m, cc, ít/ĐVN/Người làm việc đó",
      "styleAttributes": {},
      "x": -2455,
      "y": 3427,
      "width": 320,
      "height": 152
    },
    {
      "id": "df18fe8838f795f1",
      "type": "text",
      "text": "# hoti",
      "styleAttributes": {},
      "x": -5420,
      "y": 860,
      "width": 130,
      "height": 60
    },
    {
      "id": "134b23f3c53a87d7",
      "type": "text",
      "text": "# Bhāgavā",
      "styleAttributes": {},
      "x": -5200,
      "y": 860,
      "width": 260,
      "height": 60
    },
    {
      "id": "b782c987c599aa1c",
      "type": "text",
      "text": "# na",
      "styleAttributes": {},
      "x": -5355,
      "y": 960,
      "width": 130,
      "height": 60
    },
    {
      "id": "a0923d1adf3c8468",
      "type": "text",
      "text": "# sāmaññassa",
      "styleAttributes": {},
      "x": -5160,
      "y": 960,
      "width": 260,
      "height": 60
    },
    {
      "id": "52be9d65d6c1b3c6",
      "type": "text",
      "text": "# 2. gopova gāvo gaṇayaṃ paresaṃ, na bhāgavā sāmaññassa hoti.",
      "styleAttributes": {},
      "x": -5900,
      "y": 440,
      "width": 1120,
      "height": 100
    },
    {
      "id": "c97754a8778b9ce1",
      "type": "text",
      "text": "# iva",
      "styleAttributes": {},
      "x": -5900,
      "y": 620,
      "width": 160,
      "height": 60
    },
    {
      "id": "62202036dd25b2f7",
      "type": "text",
      "text": "# (So)",
      "styleAttributes": {},
      "x": -5680,
      "y": 860,
      "width": 126,
      "height": 60
    },
    {
      "id": "81ecc2f973e49759",
      "type": "text",
      "text": "# gopo gāvo gaṇayaṃ paresaṃ\n## Người chăn bò đếm bò của người khác",
      "styleAttributes": {},
      "x": -5680,
      "y": 620,
      "width": 580,
      "height": 140
    },
    {
      "id": "d6f9591a9b60058f",
      "type": "text",
      "text": "# Hoti",
      "styleAttributes": {},
      "x": -5637,
      "y": -2004,
      "width": 260,
      "height": 60
    },
    {
      "id": "e39fe6d14bbf329c",
      "type": "text",
      "text": "# (Và) Người ấy là người dễ duôi...",
      "styleAttributes": {},
      "x": -5834,
      "y": -160,
      "width": 730,
      "height": 80
    },
    {
      "id": "b60a7bb73a19c4d3",
      "type": "text",
      "text": "# naro\nn, m, cc, ít/VN CĐL/người",
      "styleAttributes": {},
      "x": -5524,
      "y": -533,
      "width": 263,
      "height": 135
    },
    {
      "id": "0f76f2d2d02ed030",
      "type": "text",
      "text": "# pamatto\nadj, m, cc, ít/BNTT cho naro/dễ duôi",
      "styleAttributes": {},
      "x": -5361,
      "y": -383,
      "width": 257,
      "height": 138
    },
    {
      "id": "b76c63a287a7e330",
      "type": "text",
      "text": "# (So)",
      "styleAttributes": {},
      "x": -5834,
      "y": -491,
      "width": 130,
      "height": 177
    },
    {
      "id": "e263d301ef230eb0",
      "type": "text",
      "text": "# sahitaṃ\nn, nt, TBC, ít/TTTT cho HTPT bhāsamāno/kinh điển",
      "styleAttributes": {},
      "x": -6120,
      "y": -1830,
      "width": 270,
      "height": 155
    },
    {
      "id": "ac1b2350810de258",
      "type": "text",
      "text": "# takkaro\n(= Tad + karo)\nn, m, cc, ít/ĐVN/Người làm việc đó\n[takkara 1](https://dpdict.net/?q=takkaro#takkara_1) adj. **who does that; doing that; acting accordingly** [►](https://dpdict.net/?q=takkaro#takkara_1)",
      "styleAttributes": {},
      "x": -5240,
      "y": -2004,
      "width": 320,
      "height": 240
    },
    {
      "id": "4a59d6b0bcf96b7c",
      "type": "text",
      "text": "# bhāsamāno\nHTPT, dùng như noun, m, cc, ít/chủ từ/người nói",
      "styleAttributes": {},
      "x": -6190,
      "y": -2037,
      "width": 300,
      "height": 125
    },
    {
      "id": "5549e557c0170480",
      "type": "text",
      "text": "# 1. bahuṃ pi ce sahitaṃ bhāsamāno, na takkaro hoti naro pamatto. \n# 2. gopova gāvo gaṇayaṃ paresaṃ, na bhāgavā sāmaññassa hoti. ",
      "styleAttributes": {},
      "x": -6360,
      "y": -3800,
      "width": 880,
      "height": 240
    },
    {
      "id": "d6b087ddc525b925",
      "type": "text",
      "text": "# bahuṃ\nadi, nt, TBC, ít/BNTT cho sahitaṃ/nhiều",
      "styleAttributes": {},
      "x": -5950,
      "y": -1655,
      "width": 255,
      "height": 120
    },
    {
      "id": "51ad5918f85dbbf6",
      "type": "text",
      "text": "# na\nphụ từ/phủ định cho karo/không",
      "styleAttributes": {},
      "x": -5473,
      "y": -1884,
      "width": 192,
      "height": 120
    },
    {
      "id": "77ec78340eeb209a",
      "type": "text",
      "text": "# Câu 1: bahuṃ pi ce sahitaṃ bhāsamāno, na takkaro hoti naro pamatto (Câu đẳng lập)",
      "styleAttributes": {},
      "x": -6580,
      "y": -2276,
      "width": 1600,
      "height": 84
    },
    {
      "id": "260e8478b32cf5b9",
      "type": "text",
      "text": "# nếu [Người nói nhiều kinh điển mà không phải là người thực hành]",
      "styleAttributes": {},
      "x": -6250,
      "y": -1440,
      "width": 1270,
      "height": 140
    },
    {
      "id": "941a18d1de87b03d",
      "type": "text",
      "text": "# ce\nphụ từ/thường đi với từ đầu tiên trong câu/nếu\n\n---\n# Mệnh đề Nếu\n# Chỉ điều kiện",
      "styleAttributes": {},
      "x": -6580,
      "y": -2057,
      "width": 280,
      "height": 577
    },
    {
      "id": "51d5e2fd6478dfd3",
      "type": "text",
      "text": "# bhāsamāno\nHTPT, dùng như noun, m, cc, ít/chủ từ/người nói",
      "styleAttributes": {},
      "x": -540,
      "y": -3397,
      "width": 300,
      "height": 125
    },
    {
      "id": "5f5ecb80102e66ff",
      "type": "text",
      "text": "# sahitaṃ\nn, nt, TBC, ít/TTTT cho HTPT bhāsamāno/kinh điển",
      "styleAttributes": {},
      "x": -470,
      "y": -3190,
      "width": 270,
      "height": 155
    },
    {
      "id": "10ee3654b2bebcb1",
      "type": "text",
      "text": "## NẾU Người nói ít kinh điển, mà thực hành Pháp theo đúng Pháp",
      "styleAttributes": {},
      "x": -540,
      "y": -2800,
      "width": 1117,
      "height": 95
    },
    {
      "id": "ab1b7693b11deeae",
      "type": "text",
      "text": "# anupādiyāno",
      "styleAttributes": {},
      "x": -2510,
      "y": -2670,
      "width": 260,
      "height": 60,
      "color": "3"
    },
    {
      "id": "1dbc53bd57b13288",
      "type": "text",
      "text": "# idha",
      "styleAttributes": {},
      "x": -2160,
      "y": -2670,
      "width": 260,
      "height": 60,
      "color": "3"
    },
    {
      "id": "8f81b036fefd73e5",
      "type": "text",
      "text": "# huraṃ",
      "styleAttributes": {},
      "x": -2160,
      "y": -2530,
      "width": 260,
      "height": 60,
      "color": "3"
    },
    {
      "id": "227800dada369b39",
      "type": "text",
      "text": "# appaṃ\nadi, nt, TBC, số ít\nít",
      "styleAttributes": {},
      "x": -300,
      "y": -3015,
      "width": 255,
      "height": 120
    },
    {
      "id": "59d533696f87585d",
      "type": "text",
      "text": "# Hoti",
      "styleAttributes": {},
      "x": -50,
      "y": -3380,
      "width": 127,
      "height": 92
    },
    {
      "id": "b6f0191b45153835",
      "type": "text",
      "text": "# anudhammacārī\n[anudhamma 2](https://dpdict.net/?q=anudhamma#anudhamma_2) adj. **according to Dhamma;**\n[cārī 1.1](https://dpdict.net/?q=c%C4%81r%C4%AB#c%C4%81r%C4%AB_1_1) adj. **living; acting; behaving;** - Tính từ hàm ý hành động; \n###  thực hành Pháp",
      "styleAttributes": {},
      "x": 280,
      "y": -3453,
      "width": 500,
      "height": 237
    },
    {
      "id": "94b7bfcd1ef0e7c7",
      "type": "text",
      "text": "# dhammassa\nDanh từ có ý niệm hành động => SHC như chủ từ hoặc như túc từ\n### Theo đúng Pháp",
      "styleAttributes": {},
      "x": 420,
      "y": -3142,
      "width": 360,
      "height": 222
    },
    {
      "id": "b8fa748353228ae5",
      "type": "text",
      "text": "# appampi ce sahitaṃ bhāsamāno, dhammassa hoti anudhammacārī.",
      "styleAttributes": {},
      "x": -930,
      "y": -3636,
      "width": 1600,
      "height": 84
    },
    {
      "id": "abb74f54f4831c7f",
      "type": "text",
      "text": "# ce\nphụ từ/thường đi với từ đầu tiên trong câu/nếu\n\n---\n# Mệnh đề Nếu\n# Chỉ điều kiện",
      "styleAttributes": {},
      "x": -930,
      "y": -3417,
      "width": 280,
      "height": 577
    },
    {
      "id": "238c7322b0e55023",
      "type": "text",
      "text": "# Sa",
      "styleAttributes": {},
      "x": -2570,
      "y": -2870,
      "width": 260,
      "height": 60,
      "color": "1"
    },
    {
      "id": "4ed863443385470d",
      "type": "text",
      "text": "# bhāgavā",
      "styleAttributes": {},
      "x": -2030,
      "y": -2870,
      "width": 260,
      "height": 60,
      "color": "4"
    },
    {
      "id": "603a1a814edbf9b1",
      "type": "text",
      "text": "\n\n# appampi ce sahitaṃ bhāsamāno, dhammassa hoti anudhammacārī.\n# rāgañca dosañca pahāya mohaṃ, sammappajāno suvimuttacitto.\n\n# anupādiyāno idha vā huraṃ vā, sa bhāgavā sāmaññassa hoti.",
      "styleAttributes": {},
      "x": -2620,
      "y": -3620,
      "width": 920,
      "height": 320
    },
    {
      "id": "8e1d725e7d45ff84",
      "type": "text",
      "text": "# sāmaññassa",
      "styleAttributes": {},
      "x": -1700,
      "y": -2720,
      "width": 260,
      "height": 50,
      "color": "4"
    },
    {
      "id": "129267dbd8ce8a21",
      "type": "text",
      "text": "## Lưu ý - Nếu muốn phủ định takkaro thông thường người ta sẽ dung a-, atakkaro",
      "styleAttributes": {},
      "x": -2281,
      "y": 1755,
      "width": 737,
      "height": 95
    },
    {
      "id": "0567fa29052b6741",
      "type": "text",
      "text": "# (so)",
      "styleAttributes": {},
      "x": -2421,
      "y": 1782,
      "width": 260,
      "height": 60
    },
    {
      "id": "f8643b50a0ed3fc5",
      "type": "text",
      "text": "# na\nphụ từ/phủ định cho karo/không",
      "styleAttributes": {},
      "x": -1956,
      "y": 1957,
      "width": 192,
      "height": 120
    },
    {
      "id": "cbfd56614bcb8cfb",
      "type": "text",
      "text": "# hoti",
      "styleAttributes": {},
      "x": -1990,
      "y": 1787,
      "width": 130,
      "height": 50,
      "color": "3"
    },
    {
      "id": "1913e27b2d495d1d",
      "type": "text",
      "text": "# bhāgavā\nn, m, cc, ít/VN CĐL/người dự phần",
      "styleAttributes": {},
      "x": -1732,
      "y": 1750,
      "width": 250,
      "height": 125,
      "color": "5"
    },
    {
      "id": "021cbc4b7339f72b",
      "type": "text",
      "text": "# sāmaññassa\nn, nt, shc, ít/SHC tổng thể/trạng thái Sa Môn",
      "styleAttributes": {},
      "x": -1531,
      "y": 1892,
      "width": 251,
      "height": 119
    },
    {
      "id": "3ec5329855f714b7",
      "type": "text",
      "text": "# paresaṃ\nn, m, shc, nhiều/SHC chỉ đối tượng SH/những người khác",
      "styleAttributes": {},
      "x": -1459,
      "y": 1527,
      "width": 285,
      "height": 160
    },
    {
      "id": "d70cbd65f7a24cac",
      "type": "text",
      "text": "# bahuṃ\nadi, nt, TBC, ít/BNTT cho sahitaṃ/nhiều",
      "styleAttributes": {},
      "x": 717,
      "y": 362,
      "width": 255,
      "height": 120
    },
    {
      "id": "57a477e63f40d1ab",
      "type": "text",
      "text": "## Người nói nhiều kinh điển mà không làm theo",
      "styleAttributes": {},
      "x": 1037,
      "y": 362,
      "width": 522,
      "height": 140
    },
    {
      "id": "8d1a8467d4c56de7",
      "type": "text",
      "text": "## Lưu ý - Người nó nhiều kinh điể không xấu, phải đến không thực hành thì mới xấu",
      "styleAttributes": {},
      "x": -2281,
      "y": 1572,
      "width": 737,
      "height": 95
    },
    {
      "id": "26cced8e6be1f59d",
      "type": "text",
      "text": "## SHC như túc từ\n## SHC tổng thể",
      "styleAttributes": {},
      "x": -1037,
      "y": 1827,
      "width": 312,
      "height": 190
    },
    {
      "id": "a230de60870d9460",
      "type": "text",
      "text": "# Hoti -> Ý niệm tồn tại - ít khi sử dụng\n# - Mở đầu\n# - Đặc thù",
      "styleAttributes": {},
      "x": -2521,
      "y": 767,
      "width": 1640,
      "height": 280
    },
    {
      "id": "9a630539e7b01a42",
      "type": "text",
      "text": "# iva: \nphụ từ/so sánh đối tượng với đối tượng khác/giống như",
      "styleAttributes": {},
      "x": -2521,
      "y": 1332,
      "width": 200,
      "height": 200
    },
    {
      "id": "18a14382aabf04dd",
      "type": "text",
      "text": "# gopo\n(gopova = gopo + iva)\nn, m, cc, ít/chủ từ/người chăn bò",
      "styleAttributes": {},
      "x": -2221,
      "y": 1332,
      "width": 267,
      "height": 160,
      "color": "1"
    },
    {
      "id": "f0cebabcf8bb03f6",
      "type": "text",
      "text": "# gaṇayaṃ\n(sắc thái: )\nHTPT, dùng như adj, m, cc, ít/BNTT cho gopo/đếm",
      "styleAttributes": {},
      "x": -1764,
      "y": 1332,
      "width": 351,
      "height": 160
    },
    {
      "id": "aeba887e38cdec45",
      "type": "text",
      "text": "# gāvo\nn, m, tbc, nhiều/TTTT gaṇayaṃ/những con bò",
      "styleAttributes": {},
      "x": -1764,
      "y": 1527,
      "width": 277,
      "height": 160
    },
    {
      "id": "c1cb3e5cbbd07f04",
      "type": "text",
      "text": "# sahitaṃ\nn, nt, TBC, ít/TTTT cho HTPT bhāsamāno/kinh điển",
      "styleAttributes": {},
      "x": 547,
      "y": 187,
      "width": 270,
      "height": 155
    },
    {
      "id": "754bd553cbdbabe8",
      "type": "text",
      "text": "# na\nphụ từ/phủ định cho karo/không",
      "styleAttributes": {},
      "x": 1367,
      "y": 205,
      "width": 192,
      "height": 120
    },
    {
      "id": "3a002900f8d016ea",
      "type": "text",
      "text": "# hoti",
      "styleAttributes": {},
      "x": 907,
      "y": -21,
      "width": 130,
      "height": 50
    },
    {
      "id": "ee547d0108d000fa",
      "type": "text",
      "text": "# naro\nn, m, cc, ít/VN CĐL/người",
      "styleAttributes": {},
      "x": 1099,
      "y": 1058,
      "width": 263,
      "height": 135
    },
    {
      "id": "7ce3ff8e3673e369",
      "type": "text",
      "text": "# (So)",
      "styleAttributes": {},
      "x": 469,
      "y": 1096,
      "width": 260,
      "height": 60
    },
    {
      "id": "aef09270d63f605f",
      "type": "text",
      "text": "# pamatto\nadj, m, cc, ít/BNTT cho naro/dễ duôi",
      "styleAttributes": {},
      "x": 1262,
      "y": 1208,
      "width": 257,
      "height": 138
    },
    {
      "id": "9fc945d0eae84d67",
      "type": "text",
      "text": "# (Và) ngườii ấy là người dễ duôi",
      "styleAttributes": {},
      "x": 469,
      "y": 1346,
      "width": 450,
      "height": 118
    },
    {
      "id": "fce829b6a84fb3f3",
      "type": "text",
      "text": "# ce\nphụ từ/thường đi với từ đầu tiên trong câu/nếu",
      "styleAttributes": {},
      "x": 39,
      "y": -121,
      "width": 280,
      "height": 125
    },
    {
      "id": "ac7d8cc6b023f7e5",
      "type": "text",
      "text": "# bhāsamāno\nHTPT, dùng như noun, m, cc, ít/chủ từ/người nói",
      "styleAttributes": {},
      "x": 377,
      "y": -59,
      "width": 300,
      "height": 125
    },
    {
      "id": "036c0dfd8491edd7",
      "type": "text",
      "text": "# takkaro\n(= Tad + karo)\nn, m, cc, ít/ĐVN/Người làm việc đó\n[takkara 1](https://dpdict.net/?q=takkaro#takkara_1) adj. **who does that; doing that; acting accordingly** [►](https://dpdict.net/?q=takkaro#takkara_1)",
      "styleAttributes": {},
      "x": 1239,
      "y": -58,
      "width": 320,
      "height": 238
    },
    {
      "id": "b688f70584fe4340",
      "type": "text",
      "text": "# bahuṃ pi ce sahitaṃ bhāsamāno, na takkaro hoti naro pamatto.",
      "styleAttributes": {},
      "x": 377,
      "y": -164,
      "width": 1182,
      "height": 87
    },
    {
      "id": "f549773056007dc0",
      "type": "text",
      "text": "# Đoạn kinh 3.4-3.5 (Dhp)**\n\n|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||\n\n# bahuṃ pi ce sahitaṃ bhāsamāno, na takkaro hoti naro pamatto.\n\n# gopova gāvo gaṇayaṃ paresaṃ, na bhāgavā sāmaññassa hoti.\n\n# appampi ce sahitaṃ bhāsamāno, dhammassa hoti anudhammacārī.\n\n# rāgañca dosañca pahāya mohaṃ, sammappajāno suvimuttacitto.\n\n# anupādiyāno idha vā huraṃ vā, sa bhāgavā sāmaññassa hoti.",
      "styleAttributes": {},
      "x": 469,
      "y": -1433,
      "width": 1060,
      "height": 480
    },
    {
      "id": "e1a731383afe98b8",
