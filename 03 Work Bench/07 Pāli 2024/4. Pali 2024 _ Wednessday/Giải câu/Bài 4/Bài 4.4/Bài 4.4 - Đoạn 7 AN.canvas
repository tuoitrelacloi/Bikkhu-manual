    {
      "id": "21fa91c0a5ca6b41",
      "type": "text",
      "text": "# Etad = etaṃ\n- ĐTNXCĐ, dùng như TT, M, CC, ÍT\n- BNTT CHO CT\n- *NÀY*",
      "styleAttributes": {},
      "x": 677,
      "y": 2660,
      "width": 443,
      "height": 156
    },
    {
      "id": "7b518c3b38c63708",
      "type": "text",
      "text": "# sukhānaṃ\n- NT, GBC/ SHC, NHIỀU\n- CN: \n- *NHỮNG SỰ LẠC*",
      "styleAttributes": {},
      "x": 1460,
      "y": 2707,
      "width": 371,
      "height": 238
    },
    {
      "id": "37e82a157301516a",
      "type": "text",
      "text": "# sukhāni\n- NT, CC, NHIỀU\n- VN TRONG CĐL\n- *sự lạc*",
      "styleAttributes": {},
      "x": -80,
      "y": 2460,
      "width": 343,
      "height": 200
    },
    {
      "id": "33dd15a548284d92",
      "type": "text",
      "text": "# Tức là, đối với 2 sự lạc này, sự lạc của người xuất gia đó là cao nhất",
      "styleAttributes": {},
      "x": 460,
      "y": 2200,
      "width": 980,
      "height": 84,
      "color": "1"
    },
    {
      "id": "b08e271c99bd7482",
      "type": "text",
      "text": "# pabbajitasukhaṃ\n- NT, CC, ÍT\n- ĐỒNG VỊ NGỮ\n- *SỰ LẠC CỦA NGƯỜI XUẤT GIA*",
      "styleAttributes": {},
      "x": 475,
      "y": 2339,
      "width": 404,
      "height": 188
    },
    {
      "id": "a20638d7d23028c8",
