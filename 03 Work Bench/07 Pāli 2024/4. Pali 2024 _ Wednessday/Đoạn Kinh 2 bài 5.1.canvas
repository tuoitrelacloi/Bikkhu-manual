      "height": 100
    },
    {
      "id": "47763c10c0a74548",
      "type": "text",
      "text": "# Yo hi koci manussesu, issatthaṃ upajīvati.\n\n# evaṃ Vāseṭṭha jānāhi, yodhājīvo na brāhmaṇo.",
      "styleAttributes": {},
      "x": 530,
