    },
    {
      "id": "dc4dad6554dd0cc6",
      "type": "text",
      "text": "# gorakkhaṃ\nDanh, NỮ. TBC\n**Giứ bò**",
      "styleAttributes": {},
      "x": 1800,
      "y": 1195,
      "width": 260,
      "height": 132
    },
    {
      "id": "d44a132b85de92a8",
