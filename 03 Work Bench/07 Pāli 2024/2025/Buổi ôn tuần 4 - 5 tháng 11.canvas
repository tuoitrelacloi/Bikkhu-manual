    },
    {
      "id": "80b0fdc9969f5244",
      "type": "text",
      "text": "# Paraṃ\nTính\n",
      "styleAttributes": {},
      "x": 14200,
      "y": -680,
      "width": 260,
      "height": 320
    },
    {
      "id": "5d6f2d84c9a8e97e",
      "type": "text",
      "text": "# Sabba-dānaṃ\n## Danh từ ghép, CC hoặc TBC\n---\nTất cả sự bố thí",
      "styleAttributes": {},
      "x": 8140,
      "y": 1224,
      "width": 340,
      "height": 426
    },
    {
      "id": "81150a4f2bb5c3bf",
      "type": "text",
      "text": "# Sự bố thí Pháp vượt lên \n## tất cả sự bố thí \n",
      "styleAttributes": {},
      "x": 7150,
      "y": 680,
      "width": 1200,
      "height": 380
    },
    {
      "id": "3958ffa98518b5ea",
      "type": "text",
      "text": "# Dhamma-dānaṃ\n## Danh từ ghép. CC hoặc TBC\n---\n### Sự bố thí Pháp",
      "styleAttributes": {},
      "x": 7000,
      "y": 1300,
      "width": 440,
      "height": 286
    },
    {
      "id": "3eb5e60cc0522c95",
      "type": "text",
      "text": "# Sukhaṃ\nDanh, Trung. CC hoặc TBC\n## Sự an lạc\n",
      "styleAttributes": {},
      "x": 13320,
      "y": -100,
      "width": 260,
      "height": 240
    },
    {
      "id": "11efa9b0436c8b1d",
      "type": "text",
      "text": "# Sabbadānaṃ\n## Danh từ ghép, CC hoặc TBC\n---\nTất cả sự bố thí",
      "styleAttributes": {},
      "x": 6990,
      "y": 2100,
      "width": 340,
      "height": 426
    },
    {
      "id": "b7594747b97d9ce6",
      "type": "text",
      "text": "# Na - atthi\nĐộng. HT. Chủ động\n## Không có ",
      "styleAttributes": {},
      "x": 13800,
      "y": -70,
      "width": 260,
      "height": 180
    },
    {
      "id": "18d65f3c471dc644",
      "type": "text",
      "text": "# Không có sự an lạc bên ngoài sự an tịnh",
      "styleAttributes": {},
      "x": 13305,
      "y": 580,
      "width": 550,
      "height": 140
    },
    {
      "id": "27b6b3127a1edeb4",
      "type": "text",
      "text": "# Santiparaṃ\nTính từ  GHÉP\nTT. số it  CC số ít\n### Sự an tịnh",
      "styleAttributes": {},
      "x": 13520,
      "y": 240,
      "width": 280,
      "height": 220
    },
    {
      "id": "9d6f3accc6232e55",
      "type": "text",
      "text": "# Tất cả sự bố thí vượt lên sự bố thí Pháp",
      "styleAttributes": {},
      "x": 7160,
      "y": 2596,
      "width": 1200,
      "height": 120
    },
    {
      "id": "f3850cb678fcca83",
      "type": "text",
      "text": "# Theo Giáo lý, thì sự bố thí Pháp  vượt lên trên tất cẳ sự bố thí  (Không kể bố thì Pháp)",
      "styleAttributes": {},
      "x": 6940,
      "y": 3000,
      "width": 1540,
      "height": 280
    },
    {
      "id": "0448a03c6545ba1f",
      "type": "text",
      "text": "Bên ngoài ",
      "styleAttributes": {},
      "x": 14660,
      "y": 980,
      "width": 140,
      "height": 60
    },
    {
      "id": "026d94e112c36455",
      "type": "text",
      "text": "Sự an tinh",
      "styleAttributes": {},
      "x": 14750,
      "y": 1100,
      "width": 140,
      "height": 60
    },
    {
      "id": "abd3fb88400d48dc",
      "type": "text",
      "text": "# Jināti\nĐộng từ, HT, CĐ\nNgôi 3 số ít. MTC\nVượt lên",
      "styleAttributes": {},
      "x": 7620,
      "y": 1353,
      "width": 260,
      "height": 168,
      "color": "1"
    },
